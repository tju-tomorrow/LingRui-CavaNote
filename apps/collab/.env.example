# 协同服务配置（见 docs/adr/0006）
PORT=1234

DATABASE_URL=postgres://lingrui:lingrui@localhost:5432/lingrui
REDIS_URL=redis://localhost:6379

# JWT（jose）。生产环境务必替换。
JWT_SECRET=dev-only-change-me
JWT_ISSUER=lingrui

# S3 / MinIO（附件）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lingrui
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- 真实 LLM（/api/chat）----
# 不填则 /api/chat 返回 503，前端自动降级到本地讲解器。
# 任何 OpenAI 兼容后端都可以：OpenAI / DeepSeek / Groq / Ollama / vLLM。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
