# 协同服务配置（见 docs/adr/0006）
PORT=1234

DATABASE_URL=postgres://lingrui:lingrui@localhost:5432/lingrui
REDIS_URL=redis://localhost:6379

# JWT（jose）。生产环境务必替换。
JWT_SECRET=dev-only-change-me
JWT_ISSUER=lingrui

# S3 / MinIO（附件）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lingrui
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- 真实 LLM（/api/chat）----
# 不填则 /api/chat 返回 503，前端自动降级到本地讲解器。
# 任何 OpenAI 兼容后端都可以：OpenAI / DeepSeek / Groq / Ollama / vLLM。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 部分网关要求会话标头（opencode-go）。留空则不发。
LLM_SESSION=

# ---- OpenCode Go（~/.zshrc 里 opencode-go 的 deepseek）----
# key 复用 ~/.local/share/opencode/auth.json，**不另存**。
# 直接跑 `bash scripts/dev-collab-oc.sh` 会自动注入下面四项（key 从 auth.json 读）。
# 手动配置参考：
#   OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
#   OPENAI_API_KEY=<从 auth.json 的 opencode-go.key 取>
#   LLM_MODEL=deepseek-v4.1-flash
#   LLM_SESSION=lingrui-cavanote

# ---- System One 决策模型（TypeSafe / Jev）----
# 只回答「是不是 / 多少 / 哪一个」，回带概率的标签（不生成文本）。
# 用途：检索精排（noul）、意图路由（choice）、质量打分（score）。
# 不填则 /api/systemone 返回 503，前端自动跳过重排（fail-open，功能不受影响）。
# 桌面端会自动复用 ~/.cc-agents/settings.json 里的 systemOne 配置。
TYPESAFE_API_KEY=
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
