{
  "name": "@lingrui/collab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat.ts",
    "./llm-env": "./src/llm-env.ts"
  },
  "scripts": {
    "build": "bun build src/server.ts --target=node --outfile=dist/server.js",
    "dev": "bun run build && node --env-file-if-exists=.env --watch dist/server.js",
    "start": "bun run build && node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.7.0",
    "@hocuspocus/extension-redis": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@lingrui/ai": "workspace:*",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.0.0"
  }
}
